{
  "name": "kalemio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "extension",
    "backend"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "npm run typecheck && node scripts/build.mjs",
    "dev": "node scripts/build.mjs --dev --watch",
    "typecheck": "tsc -p extension/tsconfig.json",
    "test": "vitest run",
    "test:browser": "node scripts/browser-test.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "worker:dev": "wrangler dev --config backend/wrangler.toml",
    "worker:panel": "esbuild backend/src/index.js --bundle --format=esm --platform=browser --target=es2022 --charset=utf8 --outfile=backend/worker-panel.js",
    "worker:build": "npm run worker:panel && wrangler deploy --config backend/wrangler.toml --dry-run --outdir dist",
    "worker:deploy": "wrangler deploy --config backend/wrangler.toml"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.28.2",
    "fflate": "^0.8.2",
    "miniflare": "^5.20261117.0-beta",
    "playwright-core": "^1.55.0",
    "typescript": "~5.9.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "wrangler": "^4.50.0"
  }
}
